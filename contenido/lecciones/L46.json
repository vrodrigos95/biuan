        ],
        [
          "medicine",
          "medicina"
        ],
        [
          "healthy",
          "saludable"
        ]
      ]
    },
    {
      "tipo": "tip",
      "md": "Los malestares van con **have**: *I have a headache*, *She has a fever*. Y ojo: *I have a cold* es «tengo un resfriado»; «tengo frío» es *I am cold*."
    }
  ],
