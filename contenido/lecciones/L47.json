{
  "id": "L47",
  "subnivel": "A2.2",
  "unidad": 12,
  "titulo": "Prohibido",
  "explicacion": [
    {
      "tipo": "texto",
      "md": "**must** + verbo expresa una obligación fuerte, como una regla. **mustn't** (must not) expresa una **prohibición**."
    },
    {
      "tipo": "tabla",
      "filas": [
        [
          "Obligación",
          "You must wear a seat belt.",
          "Debes usar el cinturón."
        ],
        [
          "Prohibición",
          "You mustn't smoke here.",
          "Está prohibido fumar aquí."
        ]
      ]
    },
    {
      "tipo": "tip",
      "md": "Después de must el verbo va solo: *You must stop*, nunca *You must to stop*. Y no lleva -s: *He must stop*."
    },
    {
      "tipo": "texto",
      "md": "No confundas la prohibición con la falta de obligación:"
    },
    {
      "tipo": "tabla",
      "filas": [
        [
          "You mustn't park here.",
          "Está prohibido estacionarse aquí."
        ],
