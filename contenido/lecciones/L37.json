  "unidad": 10,
  "titulo": "Más que",
  "explicacion": [
    {
      "tipo": "texto",
      "md": "Para comparar dos cosas se usa el **comparativo** + **than** (que). La forma depende de qué tan largo es el adjetivo."
    },
    {
      "tipo": "tabla",
      "filas": [
        [
          "Corto: + er",
          "tall → taller, cheap → cheaper"
        ],
        [
          "Termina en -e: + r",
          "nice → nicer, large → larger"
        ],
        [
          "Vocal corta + consonante: se duplica",
          "big → bigger, hot → hotter"
        ],
        [
          "Termina en -y: cambia a -ier",
          "easy → easier, heavy → heavier"
        ],
        [
          "Largo (2 sílabas o más): more + adjetivo",
          "more expensive, more modern"
        ]
      ]
    },
    {
      "tipo": "ejemplo",
      "en": "A plane is faster than a train.",
      "es": "Un avión es más rápido que un tren."
    },
    {
      "tipo": "ejemplo",
      "en": "This phone is more expensive than my laptop.",
      "es": "Este teléfono es más caro que mi laptop."
    },
    {
      "tipo": "tabla",
      "columnas": [
        "Irregular",
        "Comparativo",
        "Español"
      ],
      "filas": [
        [
          "good",
          "better",
          "mejor"
        ],
        [
          "bad",
          "worse",
          "peor"
        ],
        [
          "far",
          "farther",
          "más lejos"
        ]
      ]
    },
    {
      "tipo": "tip",
      "md": "Nunca se combinan las dos formas: se dice *taller*, no *more taller*."
    },
    {
      "tipo": "tip",
      "md": "El «que» de la comparación es **than**, no *that*: *taller than me*."
    },
