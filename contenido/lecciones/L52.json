      "tipo": "tabla",
      "columnas": [
        "Forma",
        "Significado",
        "Ejemplo"
      ],
      "filas": [
        [
          "**has been to**",
          "Fue y ya regresó (es una experiencia).",
          "She has been to Canada."
        ],
        [
          "**has gone to**",
          "Se fue y sigue allá.",
          "She has gone to Canada."
        ]
      ]
    },
    {
      "tipo": "tip",
      "md": "Si la persona está frente a ti, no puede haber *gone*: se dice *I have been to Monterrey*, nunca *I have gone to Monterrey* para hablar de tu experiencia."
