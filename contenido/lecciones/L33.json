{
  "id": "L33",
  "subnivel": "A2.1",
  "unidad": 9,
  "titulo": "Hace dos días",
  "explicacion": [
    {
      "tipo": "texto",
      "md": "Para decir **cuándo** pasó algo se usan expresiones de tiempo. Casi siempre van al final de la oración."
    },
    {
      "tipo": "tabla",
      "columnas": [
        "Palabra",
        "Uso",
        "Ejemplos"
      ],
      "filas": [
        [
          "**ago**",
          "hace… (va después del tiempo)",
          "two days ago, a week ago"
        ],
        [
          "**last**",
          "el… pasado (sin the)",
          "last night, last Monday, last year"
        ],
        [
          "**yesterday**",
          "ayer",
          "yesterday, yesterday morning"
        ],
        [
          "**in**",
          "con años y meses",
          "in 2020, in July"
        ]
      ]
    },
    {
      "tipo": "tip",
      "md": "**ago** va al final: se dice *two days ago*, nunca *ago two days*."
    },
    {
      "tipo": "tip",
      "md": "**last** no lleva the: *last week*, no *the last week*. Y «anoche» es **last night**, nunca *yesterday night*."
    },
    {
      "tipo": "ejemplo",
      "en": "I bought this phone a month ago.",
      "es": "Compré este teléfono hace un mes."
    },
    {
      "tipo": "texto",
      "md": "Para preguntar cuándo pasó algo se usa **When did…?**"
    },
    {
      "tipo": "ejemplo",
      "en": "When did you see Ana? I saw her two days ago.",
      "es": "¿Cuándo viste a Ana? La vi hace dos días."
    },
    {
      "tipo": "texto",
      "md": "Unidades de tiempo:"
    },
    {
      "tipo": "tabla",
      "columnas": [
        "Inglés",
        "Español"
      ],
