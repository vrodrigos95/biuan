      "preguntas": [
        {
          "id": "g01",
          "tipo": "opcion",
          "enunciado": "My brother ___ a doctor.",
          "opciones": [
            "is",
            "are",
            "am"
          ],
          "correcta": 0,
          "porque": "My brother equivale a he: is."
        },
        {
          "id": "g02",
          "tipo": "hueco",
          "frase": "She's from Mexico. She ___ from Spain.",
          "aceptadas": [
            "isn't",
            "is not"
          ],
          "pista": "negativo de is",
          "porque": "Negativo de to be con she: is not, o la forma corta isn't."
        },
        {
          "id": "g03",
          "tipo": "opcion",
          "enunciado": "I have ___ umbrella.",
          "opciones": [
            "an",
            "a",
            "any"
          ],
          "correcta": 0,
          "porque": "Umbrella empieza con sonido de vocal y es una sola: an."
        },
        {
          "id": "g04",
          "tipo": "opcion",
          "enunciado": "___ are my books.",
          "opciones": [
            "Those",
            "That",
            "This"
          ],
          "correcta": 0,
          "porque": "Books es plural y el verbo es are: those. This y that van con is."
        },
        {
          "id": "g05",
          "tipo": "opcion",
          "enunciado": "This is my sister. ___ name is Rosa.",
          "opciones": [
            "Her",
            "His",
            "Their"
          ],
          "correcta": 0,
          "porque": "El posesivo depende del dueño: es el nombre de ella, her."
        },
