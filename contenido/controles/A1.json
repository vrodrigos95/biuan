  "secciones": [
    {
      "habilidad": "gramatica",
      "titulo": "Gramática",
      "preguntas": [
        {
          "id": "g01",
          "tipo": "opcion",
          "enunciado": "My brother ___ a doctor.",
          "opciones": [
            "is",
            "are",
            "am"
          ],
          "correcta": 0,
          "porque": "My brother equivale a he: is."
        },
        {
          "id": "g02",
          "tipo": "opcion",
          "enunciado": "___ they from Chile?",
          "opciones": [
            "Are",
            "Is",
            "Do"
          ],
          "correcta": 0,
          "porque": "Con they el verbo to be es are, y en pregunta va al inicio."
        },
        {
          "id": "g03",
          "tipo": "hueco",
          "frase": "She ___ two children.",
          "opciones": [
            "has",
            "have",
            "is"
          ],
          "correcta": 0,
          "porque": "Con she se usa has."
        },
        {
          "id": "g04",
          "tipo": "opcion",
          "enunciado": "There ___ a bank next to the school.",
          "opciones": [
            "is",
            "are",
            "be"
          ],
          "correcta": 0,
          "porque": "A bank es singular: there is."
        },
        {
          "id": "g05",
          "tipo": "hueco",
          "frase": "He ___ (not / like) coffee.",
          "aceptadas": [
            "doesn't like",
            "does not like"
          ],
          "porque": "Negativo en tercera persona: doesn't + verbo sin -s."
        },
        {
          "id": "g06",
          "tipo": "ordenar",
          "respuesta": [
            "Where",
            "do",
            "you",
            "work?"
          ],
          "traduccion": "¿Dónde trabajas?",
          "porque": "Pregunta con Wh-: Where + do + sujeto + verbo."
        },
        {
          "id": "g07",
          "tipo": "opcion",
          "enunciado": "The class starts ___ 8 o'clock.",
          "opciones": [
            "at",
            "in",
            "on"
          ],
          "correcta": 0,
          "porque": "Con una hora exacta se usa at."
        },
        {
          "id": "g08",
          "tipo": "opcion",
          "enunciado": "I can ___ English and Spanish.",
          "opciones": [
            "speak",
            "speaks",
            "to speak"
          ],
          "correcta": 0,
          "porque": "Después de can va el verbo en forma base."
        }
      ]
    },
    {
      "habilidad": "vocabulario",
      "titulo": "Vocabulario",
      "preguntas": [
