          "id": "g06",
          "tipo": "hueco",
          "frase": "She ___ two children.",
          "opciones": [
            "has",
            "have",
            "is"
          ],
          "correcta": 0,
          "porque": "Con she, have cambia a has."
        },
        {
          "id": "g07",
          "tipo": "opcion",
          "enunciado": "The class starts ___ 8 o'clock.",
          "opciones": [
            "at",
            "in",
            "on"
          ],
          "correcta": 0,
          "porque": "Con una hora exacta se usa at."
        },
        {
          "id": "g08",
          "tipo": "hueco",
          "frase": "My father ___ (work) in a bank.",
          "aceptadas": [
            "works"
          ],
          "porque": "My father equivale a he: en presente simple el verbo lleva -s."
        },
        {
          "id": "g09",
          "tipo": "hueco",
          "frase": "He ___ (not / like) coffee.",
          "aceptadas": [
            "doesn't like",
            "does not like"
          ],
          "porque": "Negativo en tercera persona: doesn't + verbo sin -s."
        },
        {
          "id": "g10",
          "tipo": "opcion",
          "enunciado": "___ she take the bus to work?",
          "opciones": [
            "Does",
            "Do",
            "Is"
          ],
          "correcta": 0,
          "porque": "Pregunta en presente simple con she: Does + sujeto + verbo sin -s."
        },
        {
          "id": "g11",
          "tipo": "ordenar",
          "respuesta": [
            "I",
            "always",
            "get",
            "up",
            "at",
            "six."
          ],
          "traduccion": "Siempre me levanto a las seis.",
          "porque": "El adverbio de frecuencia va antes del verbo principal: I always get up."
        },
        {
          "id": "g12",
          "tipo": "opcion",
          "enunciado": "She loves ___.",
          "opciones": [
            "dancing",
            "dance",
            "dances"
          ],
          "correcta": 0,
          "porque": "Después de like, love y hate la actividad lleva -ing: dancing."
        },
        {
          "id": "g13",
          "tipo": "opcion",
          "enunciado": "She can ___ English.",
          "opciones": [
            "speak",
            "speaks",
            "to speak"
          ],
          "correcta": 0,
          "porque": "Después de can el verbo va en forma base, sin -s y sin to."
        },
        {
          "id": "g14",
          "tipo": "ordenar",
          "respuesta": [
            "Where",
            "do",
            "you",
            "work?"
          ],
          "traduccion": "¿Dónde trabajas?",
          "porque": "Pregunta con Wh-: Where + do + sujeto + verbo."
        },
        {
          "id": "g15",
          "tipo": "opcion",
          "enunciado": "I don't have ___ milk.",
          "opciones": [
            "any",
            "some",
            "a"
          ],
          "correcta": 0,
          "porque": "En negativo se usa any. Milk es incontable, así que no lleva a."
        },
        {
          "id": "g16",
          "tipo": "opcion",
          "enunciado": "How ___ eggs do you want?",
          "opciones": [
            "many",
            "much",
            "any"
          ],
          "correcta": 0,
          "porque": "Eggs es contable en plural: How many."
        },
        {
          "id": "g17",
          "tipo": "opcion",
          "enunciado": "I see ___ every day.",
          "opciones": [
            "him",
            "he",
            "his"
          ],
          "correcta": 0,
          "porque": "Después del verbo va el pronombre de objeto: him."
        }
